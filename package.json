{
  "name": "core-diver",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "ore-report": "esbuild scripts/oreReport.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/oreReport.mjs --log-level=warning && node node_modules/.cache/oreReport.mjs",
    "pacing": "esbuild scripts/pacing-bot.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pacingBot.mjs --log-level=warning && node node_modules/.cache/pacingBot.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vite": "^6.4.5"
  }
}
